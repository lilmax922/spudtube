# Local Pages preview secrets — copy to `.dev.vars` (git-ignored) for `wrangler pages dev`.
# Never commit real secrets. For prod, set these in Cloudflare Dashboard → Pages → Settings → Variables and Secrets.
# Hyperdrive binding `HYPERDRIVE` is configured in wrangler.jsonc; these are the additional secrets.
TMDB_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DATABASE_URL is NOT set on Pages when Hyperdrive is attached; for local `wrangler pages dev`
# against the Supabase pooler (not Docker), uncomment and paste the SESSION pooler URL
# (port 5432). Do not use the transaction pooler (port 6543) - pg writes through it hang:
# the row commits server-side but the reply never reaches the worker.
# DATABASE_URL=postgresql://user:pass@host:5432/db?pgbouncer=true&sslmode=require
