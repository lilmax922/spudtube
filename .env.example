# Local Docker Postgres (see compose.yaml). In production the DB is reached through a
# Cloudflare Hyperdrive binding (HYPERDRIVE) wrapping the Supabase SESSION pooler
# (port 5432, ?pgbouncer=true). Do not point Hyperdrive at the transaction pooler (6543):
# pg write queries through it commit server-side but the reply never returns to the Worker,
# so the request hangs and 500s. No DATABASE_URL env var is set on Pages — see wrangler.toml
# and scripts/production-wizard.mjs. For `DATABASE_URL="pooler-url" pnpm db:migrate` or
# `wrangler pages dev` with a pooler, temporarily set this to the Supabase session pooler URL.
DATABASE_URL=postgresql://spudtube:spudtube@localhost:5432/spudtube

# TMDB API v4 read access token (Bearer). Never commit a real token.
TMDB_TOKEN=

# Better Auth signing secret — generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Public base URL of this app (OAuth redirect host). Use your prod domain in
# Cloudflare Pages → Settings → Variables (e.g. https://spudtube.pages.dev).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client credentials (Cloud Console → Credentials → Web application)
# Authorized JS origins: http://localhost:3000 and https://YOUR_PROD_DOMAIN
# Redirect URIs: http://localhost:3000/api/auth/callback/google and https://YOUR_PROD_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
