# Local Docker Postgres (see compose.yaml) or Supabase pooler URL in production
DATABASE_URL=postgresql://spudtube:spudtube@localhost:5432/spudtube

# TMDB API v4 read access token
TMDB_TOKEN=

# Better Auth signing secret
BETTER_AUTH_SECRET=

# Public base URL of this app (OAuth redirect host; localhost for dev)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
